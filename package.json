{
  "name": "@husan/wal-ui",
  "version": "0.1.0",
  "description": "Wal — a bilingual (Persian / English), RTL-first React design system.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./styles/*": "./dist/styles/*",
    "./tokens.css": "./dist/styles/tokens.semantic.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --minify && node ./scripts/copy-style-sources.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:fix": "node scripts/doctor.mjs --fix",
    "prestorybook": "node scripts/doctor.mjs",
    "prebuild-storybook": "node scripts/doctor.mjs",
    "prebuild": "node scripts/doctor.mjs"
  },
  "peerDependencies": {
    "@remixicon/react": ">=4.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@eslint/js": "^9.9.0",
    "@remixicon/react": "^4.6.0",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.6",
    "i18next": "^24.2.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.1",
    "storybook": "8.6.18",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "storybook": "8.6.18",
    "@storybook/react-dom-shim": "8.6.18",
    "@storybook/csf-plugin": "8.6.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
